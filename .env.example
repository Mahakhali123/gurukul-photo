# ==============================================================================
# G-Arts Swaminarayan Gurukul Student Photo Gallery - Environment Variables
# ==============================================================================

# Google Drive Target Folder ID (Root folder containing event subfolders - each subfolder name = Event name)
GOOGLE_DRIVE_FOLDER_ID="1Dh9AjndTTraanzUak4bPKO4mJe71IJux"

# Google Drive API Key (Recommended - Get from Google Cloud Console > Credentials)
GOOGLE_DRIVE_API_KEY=""

# Optional: Google Service Account Credentials (if using a private workspace folder)
# GOOGLE_CLIENT_EMAIL=""
# GOOGLE_PRIVATE_KEY=""

# Fast face search: NO server models (Vercel-safe). Browsers compute face vectors
# and share them to the server index; NVIDIA's vision AI double-checks top matches.
# FACE_THRESHOLD: Euclidean match bar, same scale as the app slider (0.35 strict … 0.70 find-all)
FACE_THRESHOLD="0.55"
# NVIDIA_API_KEY: server-side ONLY, never client-side, never commit.
# Local dev (PowerShell, persistent): setx NVIDIA_API_KEY "<your-key-here>"
# Vercel: Project Settings > Environment Variables > NVIDIA_API_KEY
# NVIDIA_API_KEY=""
# Optional overrides:
# NVIDIA_VISION_MODEL="meta/llama-3.2-90b-vision-instruct"
# NVIDIA_CHAT_URL="https://integrate.api.nvidia.com/v1/chat/completions"
